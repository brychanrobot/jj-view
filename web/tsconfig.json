{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "..",
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.svelte",
        "test/**/*.ts",
        "../src/core/**/*.ts",
        "../src/test/test-repo.ts",
        "../src/test/perf-trace.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
