{
    "default": {
        "strategy": "cycle",
        "colors": [
            "var(--vscode-charts-green)",
            "var(--vscode-charts-blue)",
            "var(--vscode-charts-yellow)",
            "var(--vscode-charts-purple)",
            "var(--vscode-charts-red)",
            // VS Code's charts.orange fallback delegates to minimapFindMatch / editorFindMatchHighlight,
            // which has ~33% alpha (#ea5c0055). See: https://github.com/microsoft/vscode/issues/333529
            // We use --opaque() to strip the alpha channel at build time and guarantee 100% opacity.
            "--opaque(var(--vscode-charts-orange))",
            "var(--vscode-charts-foreground)"
        ]
    },
    "oceanic": {
        "strategy": "clamp",
        "colors": ["#caf0f8", "#90e0ef", "#00b4d8", "#0096c7", "#0077b6", "#023e8a", "#03045e"]
    },
    "sunset": {
        "strategy": "clamp",
        "colors": ["#ffea00", "#ffb700", "#ff9e00", "#ff8500", "#ff6d00", "#ff5400", "#ff0000"]
    },
    "neon": {
        "strategy": "cycle",
        "colors": ["#39ff14", "#ff00ff", "#00ffff", "#ffef00", "#ff0000", "#ff9900", "#bf00ff"]
    },
    "pastel": {
        "strategy": "cycle",
        "colors": ["#ffb3ba", "#ffdfba", "#ffffba", "#baffc9", "#bae1ff", "#e8baff", "#ffd1ff"]
    },
    "monochrome": {
        "strategy": "clamp",
        "colors": ["#eeeeee", "#666666", "#555555", "#444444", "#383838", "#303030", "#282828"],
        "lightColors": ["#111111", "#999999", "#aaaaaa", "#bbbbbb", "#c7c7c7", "#cfcfcf", "#d7d7d7"]
    }
}
