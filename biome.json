{
    "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120,
        "attributePosition": "auto"
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "recommended": true,
                "noImportantStyles": "off",
                "noCommaOperator": "off"
            },
            "correctness": {
                "recommended": true,
                "noUnusedVariables": "warn"
            },
            "style": {
                "recommended": true,
                "useBlockStatements": "warn"
            },
            "suspicious": {
                "recommended": true,
                "noExplicitAny": "error"
            },
            "a11y": {
                "recommended": true
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "quoteProperties": "asNeeded"
        },
        "jsxRuntime": "transparent"
    },
    "overrides": [
        {
            "includes": ["**/*.svelte"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useHookAtTopLevel": "off",
                        "noUnusedVariables": "off",
                        "noUnusedImports": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/core/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "vscode": "src/core must remain platform-agnostic with zero vscode imports.",
                                    "node:path": "Use 'pathe' instead of 'node:path' in src/core.",
                                    "path": "Use 'pathe' instead of 'path' in src/core.",
                                    "node:crypto": "Use portable utilities like 'fnv1aHash' instead of 'node:crypto' in src/core.",
                                    "crypto": "Use portable utilities like 'fnv1aHash' instead of 'crypto' in src/core.",
                                    "node:fs": "Use HostSystem.fs instead of 'node:fs' in src/core.",
                                    "fs": "Use HostSystem.fs instead of 'fs' in src/core.",
                                    "node:fs/promises": "Use HostSystem.fs instead of 'node:fs/promises' in src/core.",
                                    "fs/promises": "Use HostSystem.fs instead of 'fs/promises' in src/core.",
                                    "node:child_process": "Use HostSystem.process instead of 'node:child_process' in src/core.",
                                    "child_process": "Use HostSystem.process instead of 'child_process' in src/core.",
                                    "node:os": "Use HostSystem instead of 'node:os' in src/core.",
                                    "os": "Use HostSystem instead of 'os' in src/core.",
                                    "node:buffer": "Use portable Web APIs (Uint8Array, TextEncoder, TextDecoder, atob, btoa) instead of 'node:buffer' in src/core.",
                                    "buffer": "Use portable Web APIs instead of 'buffer' in src/core."
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/core/host/node-host-system.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": "off"
                    }
                }
            }
        }
    ]
}
